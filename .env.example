# =============================================================================
# SaaS İşletme Yönetim Platformu — Ortam Değişkenleri Örneği
# =============================================================================
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizle doldurun.
# .env dosyası asla git'e commit edilmemelidir (.gitignore'da).
# =============================================================================

# -----------------------------------------------------------------------------
# Genel
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
APP_NAME="SaaS İşletme Yönetimi"

# -----------------------------------------------------------------------------
# API (Backend)
# -----------------------------------------------------------------------------
API_PORT=3000
API_PREFIX=/api/v1
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# -----------------------------------------------------------------------------
# Web (Frontend)
# -----------------------------------------------------------------------------
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_NAME="SaaS İşletme Yönetimi"

# -----------------------------------------------------------------------------
# Veritabanı (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://saas:saas@localhost:54432/saas_dev_clean?schema=public"
DATABASE_LOGGING=false

# -----------------------------------------------------------------------------
# Redis (opsiyonel, MVP'de)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380

# -----------------------------------------------------------------------------
# JWT / Auth
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-jwt-access-secret-degistir-bunu-en-az-32-karakter
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-degistir-bunu-en-az-32-karakter
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Cloudflare R2 (veya MinIO lokal)
# -----------------------------------------------------------------------------
# MVP'de STORAGE_DRIVER=local kullanılır, prod'da r2'ye geçilir
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# Cloudflare R2 ayarları (üretim)
STORAGE_R2_ACCOUNT_ID=
STORAGE_R2_ACCESS_KEY_ID=
STORAGE_R2_SECRET_ACCESS_KEY=
STORAGE_R2_BUCKET=saas-files
STORAGE_R2_PUBLIC_URL=https://files.example.com

# -----------------------------------------------------------------------------
# Süper Admin (seed için)
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@sistem.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME="Sistem Yöneticisi"
