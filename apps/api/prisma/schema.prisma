// Prisma schema — SaaS İşletme Yönetim Platformu
// Veritabanı: PostgreSQL 16
//
// Bu şema FAZ 1 (proje iskeleti) kapsamındadır.
// Tüm tenant'lı tablolarda ortak alanlar: id, tenant_id, is_active, is_deleted,
// created_at, updated_at, created_by, updated_by, deleted_at, deleted_by.
// ERP entegrasyonu açık tablolarda ek: source_system, external_id, sync_status vs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  PENDING
  CANCELLED
}

enum WorkingMode {
  SAAS_MASTER
  ERP_MASTER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING
}

enum DataScope {
  OWN
  BRANCH
  TENANT
}

enum TenantModuleSource {
  plan
  manual_override
}

enum PlanCode {
  starter
  standard
  professional
  enterprise
  custom
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ModuleCategory {
  core
  operations
  finance
  hr
  integration
  addon
}

enum PermissionAction {
  view
  read
  create
  update
  delete
  export
  import
  print
  approve
  cancel
  manage
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SyncStatus {
  SYNCED
  PENDING
  CONFLICT
  IGNORED
}

enum SourceSystem {
  SAAS
  MICRO
  LOGO
  NETSIS
  PARASUT
  OTHER
}

// =====================================================================
// SAAS ÇEKİRDEK TABLOLAR
// =====================================================================

model Tenant {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  workingMode WorkingMode  @default(SAAS_MASTER)
  status      TenantStatus @default(TRIAL)
  isActive    Boolean      @default(true)
  isDeleted   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?

  settings                TenantSettings?
  users                   User[]
  roles                   Role[]
  subscriptions           Subscription[]
  tenantModules           TenantModule[]
  auditLogs               AuditLog[]
  errorLogs               ErrorLog[]
  securityLogs            SecurityLog[]
  notifications           Notification[]
  notificationChannels    NotificationChannel[]
  notificationRules       NotificationRule[]
  notificationLogs        NotificationLog[]
  notificationPreferences NotificationPreferences[]
  approvalRules           ApprovalRule[]
  dataCheckRules          DataCheckRule[]
  dataCheckRuns           DataCheckRun[]
  dataCheckResults        DataCheckResult[]
  dataCheckSchedules      DataCheckSchedule[]
  dataCheckActionLogs     DataCheckActionLog[]
  labelPrintJobs          LabelPrintJob[]
  llmConfigs              TenantLLMConfig[]
  assistantConversations  AssistantConversation[]
  assistantUsageStats     AssistantUsageStats[]
  approvalRequests        ApprovalRequest[]

  // FAZ 6 — Cari modülü ilişkileri
  customers         Customer[]
  customerMovements CustomerMovement[]
  cashAccounts      CashAccount[]
  cashMovements     CashMovement[]
  paymentMethods    PaymentMethod[]

  // FAZ 7 — Stok modülü ilişkileri
  units                  Unit[]
  brands                 Brand[]
  productCategories      ProductCategory[]
  warehouses             Warehouse[]
  products               Product[]
  productBarcodes        ProductBarcode[]
  productPrices          ProductPrice[]
  warehouseTransfers     WarehouseTransfer[]
  warehouseTransferItems WarehouseTransferItem[]
  stockMovements         StockMovement[]

  // FAZ 8 — Satış modülü ilişkileri
  sales           Sale[]
  saleItems       SaleItem[]
  orders          Order[]
  orderItems      OrderItem[]
  collections     Collection[]
  stockCounts     StockCount[]
  stockCountItems StockCountItem[]

  returns     Return[]
  returnItems ReturnItem[]

  purchaseInvoices     PurchaseInvoice[]
  purchaseInvoiceItems PurchaseInvoiceItem[]

  bankAccounts     BankAccount[]
  bankTransactions BankTransaction[]
  posDevices       PosDevice[]
  posCollections   PosCollection[]

  importBatches ImportBatch[]
  importRows    ImportRow[]

  apiKeys           ApiKey[]
  apiKeyUsageLogs   ApiKeyUsageLog[]
  webhooks          Webhook[]
  webhookDeliveries WebhookDelivery[]

  helpArticles   HelpArticle[]
  assistantTools AssistantTool[]

  // FAZ 27 — White-Label / Marka Ayarları
  whiteLabel Json? // { logo, primaryColor, slogan, supportEmail, supportPhone, customDomain, loginPageSettings, emailTemplates, pdfSettings }

  priceLists          PriceList[]
  customerPriceGroups CustomerPriceGroup[]
  campaigns           Campaign[]

  documentTemplates DocumentTemplate[]

  reportTemplates          ReportTemplate[]
  scheduledReports         ScheduledReport[]
  OnboardingProgress       OnboardingProgress?
  OnboardingStepLog        OnboardingStepLog[]
  TenantAppliedTemplate    TenantAppliedTemplate[]
  DemoCompany              DemoCompany?
  VisitPlan                VisitPlan[]
  PerformanceTarget        PerformanceTarget[]
  PerformanceSnapshot      PerformanceSnapshot[]
  CommissionRule           CommissionRule[]
  CommissionCalculationLog CommissionCalculationLog[]
  IdempotencyKey           IdempotencyKey[]
  HrEmployee               HrEmployee[]
  HrEmployeeEmploymentInfo HrEmployeeEmploymentInfo[]
  HrEmployeeDocument       HrEmployeeDocument[]
  HrOnboardingChecklist        HrOnboardingChecklist[]
  HrOnboardingChecklistItem    HrOnboardingChecklistItem[]
  HrOffboardingChecklist       HrOffboardingChecklist[]
  HrOffboardingChecklistItem   HrOffboardingChecklistItem[]
  HrLeaveType               HrLeaveType[]
  HrLeaveBalance            HrLeaveBalance[]
  HrLeaveRequest            HrLeaveRequest[]
  HrLeaveAdjustment         HrLeaveAdjustment[]
  HrPayrollPeriod           HrPayrollPeriod[]
  HrPayrollRecord           HrPayrollRecord[]
  HrPayrollSupplement       HrPayrollSupplement[]
  HrAbsenceRecord           HrAbsenceRecord[]
  HrDisciplinaryCase        HrDisciplinaryCase[]
  HrCareerRecord            HrCareerRecord[]
  HrTraining                HrTraining[]
  HrPerformanceReview       HrPerformanceReview[]
  HrPayrollParam            HrPayrollParam[]
  HrPunchRecord             HrPunchRecord[]
  HrAdvanceRequest          HrAdvanceRequest[]
  HrAdvanceRepayment        HrAdvanceRepayment[]

  @@index([status])
  @@index([isDeleted])
}

model TenantSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  companyInfo        Json     @default("{}")
  currency           String   @default("TRY")
  locale             String   @default("tr-TR")
  taxOffice          String?
  taxNumber          String?
  defaultWarehouseId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id           String     @id @default(cuid())
  tenantId     String?
  email        String
  phone        String?
  passwordHash String
  fullName     String
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  mfaEnabled   Boolean    @default(false)
  lastLoginAt  DateTime?
  isActive     Boolean    @default(true)
  isDeleted    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?

  tenant                  Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles               UserRole[]
  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]               @relation("AuditLogUser")
  securityLogs            SecurityLog[]            @relation("SecurityLogUser")
  notifications           Notification[]           @relation("NotificationUser")
  notificationPreferences NotificationPreferences?
  AssistantConversation   AssistantConversation[]
  leaveRequests           HrLeaveRequest[]          @relation("LeaveRequestApprover")

  performanceReviews HrPerformanceReview[]

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId, isDeleted])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String?
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  module      String
  resource    String
  action      PermissionAction
  description String?
  createdAt   DateTime         @default(now())

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  tenantId  String
  dataScope DataScope @default(TENANT)
  branchIds String[]  @default([])
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId])
  @@index([tenantId])
}

model Module {
  id           String         @id @default(cuid())
  code         String         @unique
  name         String
  category     ModuleCategory
  defaultRoute String
  icon         String
  sortOrder    Int            @default(100)
  description  String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())

  planModules   PlanModule[]
  tenantModules TenantModule[]
}

model Plan {
  id             String   @id @default(cuid())
  code           PlanCode @unique
  name           String
  description    String?
  monthlyPrice   Decimal  @default(0) @db.Decimal(10, 2)
  yearlyPrice    Decimal  @default(0) @db.Decimal(10, 2)
  currency       String   @default("TRY")
  userLimit      Int      @default(0)
  branchLimit    Int      @default(0)
  warehouseLimit Int      @default(0)
  apiKeyLimit    Int      @default(0)
  webhookLimit   Int      @default(0)
  storageMbLimit Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  planModules   PlanModule[]
  subscriptions Subscription[]
}

model PlanModule {
  id          String  @id @default(cuid())
  planId      String
  moduleId    String
  isIncluded  Boolean @default(true)
  customLimit Json?
  plan        Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
}

model TenantModule {
  id            String             @id @default(cuid())
  tenantId      String
  moduleId      String
  isActive      Boolean            @default(true)
  source        TenantModuleSource @default(plan)
  limitOverride Json?
  validUntil    DateTime?
  note          String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@index([tenantId, isActive])
}

model Subscription {
  id         String             @id @default(cuid())
  tenantId   String
  planId     String
  status     SubscriptionStatus @default(TRIAL)
  startAt    DateTime           @default(now())
  endAt      DateTime?
  trialEndAt DateTime?
  autoRenew  Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([endAt])
}

// =====================================================================
// AUTH YARDIMCI
// =====================================================================

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  tenantId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// =====================================================================
// LOG TABLOLARI
// =====================================================================

model AuditLog {
  id            String    @id @default(cuid())
  tenantId      String?
  userId        String?
  module        String
  action        String
  entityType    String
  entityId      String?
  oldValues     Json?
  newValues     Json?
  changedFields String[]  @default([])
  ipAddress     String?
  userAgent     String?
  requestId     String?
  riskLevel     RiskLevel @default(LOW)
  createdAt     DateTime  @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([riskLevel])
}

model ErrorLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  level      String   @default("ERROR")
  message    String
  stackTrace String?
  path       String?
  method     String?
  statusCode Int?
  requestId  String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([level])
}

model SecurityLog {
  id        String    @id @default(cuid())
  tenantId  String?
  userId    String?
  event     String
  ipAddress String?
  userAgent String?
  riskLevel RiskLevel @default(LOW)
  metadata  Json?
  createdAt DateTime  @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation("SecurityLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([event])
}

// =====================================================================
// BİLDİRİM SİSTEMİ
// =====================================================================

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
}

enum NotificationCategory {
  SYSTEM
  SECURITY
  TENANT
  PLAN
  MODULE
  USER
  SALE
  COLLECTION
  STOCK
  ORDER
  INVOICE
  REPORT
}

// =====================================================================
// ENUMLAR — CARİ MODÜLÜ (FAZ 6)
// =====================================================================

enum CustomerType {
  CUSTOMER // Müşteri (bizden alan)
  SUPPLIER // Tedarikçi (bize satan)
  BOTH // İkisi birden
}

enum CustomerStatus {
  ACTIVE
  PASSIVE
  BLOCKED // Bloke (yeni satış yok)
}

enum CustomerMovementType {
  DEBIT // Bizim alacağımız (müşteri bize borçlandı)
  CREDIT // Bizim borcumuz (müşteriye ödedik veya alacak)
}

enum CustomerMovementRefType {
  SALE
  SALE_CANCEL
  PURCHASE
  PURCHASE_CANCEL
  COLLECTION
  COLLECTION_CANCEL
  RETURN
  ADJUST
  OPENING_BALANCE
  TRANSFER
}

enum CashAccountType {
  CASH
  BANK
  POS
}

enum CashAccountStatus {
  ACTIVE
  PASSIVE
}

enum CashMovementType {
  IN
  OUT
  TRANSFER
}

enum CashMovementRefType {
  COLLECTION
  COLLECTION_CANCEL
  PAYMENT
  PAYMENT_CANCEL
  SALE_REFUND
  TRANSFER
  ADJUST
  OPENING_BALANCE
}

enum PaymentMethodType {
  CASH
  CARD
  BANK
  EFT
  CHECK
  OTHER
}

enum MovementStatus {
  DRAFT // Henüz muhasebeleşmedi
  POSTED // Kesin kayıt
  PENDING // Onay bekliyor
  CANCELLED // İptal edildi
}

// =====================================================================
// ENUMLAR — STOK MODÜLÜ (FAZ 7)
// =====================================================================

enum UnitType {
  PIECE // Adet (adet, koli, paket)
  WEIGHT // Ağırlık (kg, gr, ton)
  LENGTH // Uzunluk (mt, cm, mm)
  VOLUME // Hacim (lt, m3)
  TIME // Zaman (saat, gün)
  AREA // Alan (m2)
}

enum ProductType {
  GOODS // Ticari mal
  SERVICE // Hizmet (stok takibi yok)
  RAW_MATERIAL // Hammadde
  FINISHED_GOOD // Mamul
  CONSUMABLE // Sarf malzeme
}

enum ProductStatus {
  DRAFT
  ACTIVE
  PASSIVE
  DISCONTINUED // Üretimi durdurulmuş
}

enum StockMovementRefType {
  SALE
  SALE_CANCEL
  PURCHASE
  PURCHASE_CANCEL
  TRANSFER
  TRANSFER_CANCEL
  ADJUST
  COUNT // Sayım düzeltmesi
  OPENING_BALANCE
  RETURN
  PRODUCTION // Üretim girişi
  WASTE // Fire / zayiat
}

enum WarehouseStatus {
  ACTIVE
  PASSIVE
}

enum PriceType {
  PURCHASE // Alış fiyatı
  SALE // Satış fiyatı
  WHOLESALE // Toptan
  MIN_SALE // Alt sınır (müşteriye altında satılmaz)
  LIST_PRICE // Liste / katalog fiyatı
}

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUST
}

// =====================================================================
// ENUMLAR — SATIŞ MODÜLÜ (FAZ 8)
// =====================================================================

enum SaleType {
  SALE // Normal satış
  RETURN // İade
  PROFORMA // Proforma (henüz kesin değil)
  CONSIGNMENT_OUT // Konsinyasyon çıkışı
  CONSIGNMENT_IN // Konsinyasyon iadesi
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  CLOSED
}

enum PaymentStatus {
  UNPAID // Hiç ödenmedi
  PARTIALLY_PAID // Kısmen ödendi
  PAID // Tamamı ödendi
}

enum SaleItemStatus {
  ACTIVE
  CANCELLED
}

model Notification {
  id        String               @id @default(cuid())
  tenantId  String?
  userId    String? // null = tenant'taki tüm kullanıcılara
  type      NotificationType     @default(INFO)
  category  NotificationCategory @default(SYSTEM)
  title     String
  message   String
  link      String? // frontend'de gidilecek sayfa
  metadata  Json?
  isRead    Boolean              @default(false)
  readAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime             @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([userId, isRead])
  @@index([tenantId, isRead])
  @@index([category])
  @@index([expiresAt])
}

// =====================================================================
// CARİ MODÜLÜ MODELLERİ (FAZ 6)
// =====================================================================
//
// Event sourcing: bakiye/stok/kasa SAKLANMAZ, hareketlerden hesaplanır.
// Bu yüzden modellerde balance/quantity/cashBalance gibi alanlar YOK.
// Sadece hareket (movement) tabloları gerçek kaynaktır.
//
// Müşteri ve tedarikçi tek tabloda (Customer), type alanı ile ayrılır.
// Bu hem sorgu performansı hem ERP entegrasyonu için daha sağlıklıdır.
// =====================================================================

// ÖDEME YÖNTEMİ TANIMLARI (Cari / Stok / Satış'ta kullanılır)
model PaymentMethod {
  id        String            @id @default(cuid())
  tenantId  String? // null = sistem tanımı
  code      String // "CASH", "CARD", "EFT"...
  name      String // "Nakit", "Kredi Kartı", "Havale/EFT"
  type      PaymentMethodType
  isActive  Boolean           @default(true)
  isDefault Boolean           @default(false)
  sortOrder Int               @default(0)
  notes     String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashMovements CashMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([tenantId, type])
}

// CARİ HESAP (MÜŞTERİ + TEDARİKÇİ)
model Customer {
  id              String         @id @default(cuid())
  tenantId        String
  code            String // "M-0001", "T-0001", "H-0001" (tenant-scoped unique)
  type            CustomerType
  name            String // Firma/şahıs adı
  contactName     String? // Yetkili kişi
  taxNumber       String? // VKN
  taxOffice       String? // VD
  identityNumber  String? // TCKN (şahıslar için)
  address         String?
  city            String?
  district        String?
  postalCode      String?
  country         String?        @default("Türkiye")
  phone           String?
  phone2          String?
  email           String?
  website         String?
  iban            String?
  openingBalance  Decimal        @default(0) // Açılış fişi (pozitif: alacak, negatif: borç — yön için)
  creditLimit     Decimal        @default(0) // Açık hesap limiti
  paymentTermDays Int            @default(0) // Vade (gün)
  status          CustomerStatus @default(ACTIVE)
  notes           String?

  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements   CustomerMovement[]
  sales       Sale[]
  orders      Order[]
  collections Collection[]

  returns Return[]

  purchaseInvoices PurchaseInvoice[]

  priceGroupMembers CustomerPriceGroupMember[]
  campaigns         Campaign[]

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
  @@index([tenantId, type])
  @@index([tenantId, name])
  @@index([tenantId, taxNumber])
  @@index([tenantId, phone])
}

// CARİ HAREKET (event-sourced — bakiye buradan hesaplanır)
model CustomerMovement {
  id           String                  @id @default(cuid())
  tenantId     String
  customerId   String
  type         CustomerMovementType // DEBIT (bizim alacağımız) | CREDIT (bizim borcumuz)
  amount       Decimal // Dövizli tutar (currency cinsinden)
  currency     String                  @default("TRY")
  exchangeRate Decimal                 @default(1) // TRY karşılığı için çevrim
  amountTry    Decimal // TL bazında muhasebe tutarı (amount * exchangeRate)
  movementDate DateTime // Hareket tarihi
  dueDate      DateTime? // Vade (tahsilat planı için)
  refType      CustomerMovementRefType // SALE | COLLECTION | ...
  refId        String? // İlgili döküman ID (Sale.id, vb.)
  refNumber    String? // İnsan-okunabilir referans
  description  String?
  status       MovementStatus          @default(POSTED)

  // Ters kayıt alanları (soft delete yerine)
  // Tek bir relation çifti: bu kayıt → iptal ettiği kayıt (ve back-relation: beni iptal eden)
  reversesId String? @unique

  paymentMethodId String? // Tahsilat/ödeme ise hangi yöntemle
  cashAccountId   String? // Tahsilat/ödeme ise hangi kasa/banka

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reverses   CustomerMovement? @relation("CustomerMovementReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy CustomerMovement? @relation("CustomerMovementReversal")

  @@index([tenantId, customerId, movementDate])
  @@index([tenantId, movementDate])
  @@index([tenantId, refType, refId])
  @@index([tenantId, dueDate])
  @@index([customerId, status])
  @@index([reversesId])
}

// KASA / BANKA HESABI
model CashAccount {
  id            String            @id @default(cuid())
  tenantId      String
  code          String // "K-001", "B-001", "P-001"
  name          String
  type          CashAccountType
  status        CashAccountStatus @default(ACTIVE)
  currency      String            @default("TRY")
  iban          String?
  bankName      String?
  bankBranch    String?
  accountHolder String?
  isDefault     Boolean           @default(false)
  notes         String?

  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements           CashMovement[] @relation("CashAccountSource")
  collections         Collection[]
  transferToMovements CashMovement[] @relation("CashAccountTransfer")

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
  @@index([tenantId, type])
}

// KASA / BANKA HAREKETİ (event-sourced)
model CashMovement {
  id            String              @id @default(cuid())
  tenantId      String
  cashAccountId String
  type          CashMovementType // IN | OUT | TRANSFER
  amount        Decimal
  currency      String              @default("TRY")
  exchangeRate  Decimal             @default(1)
  amountTry     Decimal
  movementDate  DateTime
  refType       CashMovementRefType
  refId         String?
  refNumber     String?
  description   String?
  status        MovementStatus      @default(POSTED)

  // Transfer için: kaynak ve hedef hesap
  transferToAccountId String? // TRANSFER tipinde hedef hesap

  // İlişkili carı (tahsilat ise) — opsiyonel
  customerId         String?
  customerMovementId String? @unique // Bağlı cari hareket (tahsilat/ödeme)

  paymentMethodId String?
  reversesId      String? @unique

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashAccount       CashAccount    @relation("CashAccountSource", fields: [cashAccountId], references: [id], onDelete: Restrict)
  transferToAccount CashAccount?   @relation("CashAccountTransfer", fields: [transferToAccountId], references: [id], onDelete: SetNull)
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  reverses          CashMovement?  @relation("CashMovementReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy        CashMovement?  @relation("CashMovementReversal")
  collections       Collection[]

  @@index([tenantId, cashAccountId, movementDate])
  @@index([tenantId, movementDate])
  @@index([tenantId, refType, refId])
  @@index([customerId])
  @@index([reversesId])
}

// =====================================================================
// STOK MODÜLÜ MODELLERİ (FAZ 7)
// =====================================================================
//
// Event sourcing: stok miktarı SAKLANMAZ, hareketlerden hesaplanır.
// Bu yüzden Product tablosunda quantity YOK.
// Stok miktarı: SUM(stock_movements WHERE type=IN) - SUM(stock_movements WHERE type=OUT)
// Depo bazında: (productId, warehouseId) çifti üzerinden gruplanır.
// =====================================================================

// ÖLÇÜ BİRİMİ TANIMLARI (Sistem + tenant override)
model Unit {
  id        String   @id @default(cuid())
  tenantId  String? // null = sistem tanımı
  code      String // "ADET", "KG", "MT", "LT", "KOLI", "SAAT"
  name      String // "Adet", "Kilogram", "Metre"
  type      UnitType
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([tenantId, type])
}

// MARKA
model Brand {
  id       String  @id @default(cuid())
  tenantId String
  code     String
  name     String
  country  String?
  isActive Boolean @default(true)
  notes    String?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
}

// ÜRÜN KATEGORİSİ (ağaç yapısı, parentId self-FK)
model ProductCategory {
  id        String  @id @default(cuid())
  tenantId  String
  code      String
  name      String
  parentId  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  notes     String?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@index([tenantId, isDeleted])
}

// DEPO
model Warehouse {
  id                String          @id @default(cuid())
  tenantId          String
  code              String
  name              String
  status            WarehouseStatus @default(ACTIVE)
  branch            String? // Şube adı
  manager           String? // Sorumlu personel adı
  managerUserId     String? // Sorumlu kullanıcı (User.id) — opsiyonel
  authorizedUserIds String[] // Yetkili kullanıcılar
  address           String?
  city              String?
  phone             String?
  isDefault         Boolean         @default(false)
  notes             String?

  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultForProducts Product[]           @relation("DefaultWarehouse")
  stockMovementsFrom StockMovement[]     @relation("WarehouseFrom")
  stockMovementsTo   StockMovement[]     @relation("WarehouseTo")
  sales              Sale[]
  orders             Order[]
  transfers          WarehouseTransfer[]
  transferTo         WarehouseTransfer[] @relation("WarehouseTransferTo")
  stockCounts        StockCount[]
  purchaseInvoices   PurchaseInvoice[]

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
}

// ÜRÜN
model Product {
  id                 String        @id @default(cuid())
  tenantId           String
  code               String // SKU (tenant-scoped unique)
  name               String
  shortName          String?
  description        String?
  type               ProductType   @default(GOODS)
  status             ProductStatus @default(ACTIVE)
  brandId            String?
  categoryId         String?
  defaultWarehouseId String?
  unitId             String?
  primaryBarcode     String? // En sık kullanılan barkod (ProductBarcode'dan bağımsız)
  trackStock         Boolean       @default(true) // Hizmetlerde false
  vatRate            Decimal       @default(20) // KDV oranı (%)
  minStock           Decimal       @default(0) // Alt uyarı sınırı
  maxStock           Decimal       @default(0) // Üst uyarı sınırı (0 = limitsiz)
  weight             Decimal? // Net ağırlık (kg)
  volume             Decimal? // Hacim (m3)

  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand                  Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category               ProductCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  defaultWarehouse       Warehouse?              @relation("DefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  unit                   Unit?                   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  barcodes               ProductBarcode[]
  prices                 ProductPrice[]
  stockMovements         StockMovement[]
  saleItems              SaleItem[]
  orderItems             OrderItem[]
  warehouseTransferItems WarehouseTransferItem[]
  stockCountItems        StockCountItem[]

  returnItems ReturnItem[]

  purchaseInvoiceItems PurchaseInvoiceItem[]

  priceListItems PriceListItem[]
  campaigns      Campaign[]

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
  @@index([tenantId, type])
  @@index([tenantId, name])
  @@index([tenantId, brandId])
  @@index([tenantId, categoryId])
  @@index([tenantId, primaryBarcode])
}

// ÜRÜN BARKODLARI (1 ürünün birden fazla barkodu olabilir, örn: koli barkodu)
model ProductBarcode {
  id        String  @id @default(cuid())
  tenantId  String
  productId String
  barcode   String
  unitId    String? // Barkodun temsil ettiği birim (örn: koli = 12 adet)
  quantity  Decimal @default(1) // Bu barkodun kaç adet temsil ettiği
  isPrimary Boolean @default(false)
  notes     String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, barcode])
  @@index([tenantId, productId])
  @@index([productId, isPrimary])
}

// ÜRÜN FİYATLARI (Alış / Satış / Toptan / Liste — dönemsel olabilir)
model ProductPrice {
  id        String    @id @default(cuid())
  tenantId  String
  productId String
  type      PriceType
  amount    Decimal
  currency  String    @default("TRY")
  validFrom DateTime  @default(now())
  validTo   DateTime?
  notes     String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, type])
  @@index([tenantId, type])
  @@index([productId, validFrom])
}

// STOK HAREKETİ (event-sourced — miktar buradan hesaplanır)
model StockMovement {
  id           String               @id @default(cuid())
  tenantId     String
  productId    String
  warehouseId  String // Birincil depo (TRANSFER'de kaynak)
  type         StockMovementType // IN | OUT | TRANSFER | ADJUST
  quantity     Decimal // Pozitif (yön type'ta)
  unitCost     Decimal? // Birim maliyet (opsiyonel, maliyet raporları için)
  movementDate DateTime
  refType      StockMovementRefType // SALE | PURCHASE | TRANSFER | ADJUST | COUNT | ...
  refId        String?
  refNumber    String?
  description  String?
  status       MovementStatus       @default(POSTED)

  // TRANSFER için hedef depo
  transferToWarehouseId String?

  // Ters kayıt (self-relation)
  reversesId String? @unique

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product             Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse           Warehouse      @relation("WarehouseFrom", fields: [warehouseId], references: [id], onDelete: Restrict)
  transferToWarehouse Warehouse?     @relation("WarehouseTo", fields: [transferToWarehouseId], references: [id], onDelete: SetNull)
  reverses            StockMovement? @relation("StockMovementReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy          StockMovement? @relation("StockMovementReversal")

  @@index([tenantId, productId, warehouseId, movementDate])
  @@index([tenantId, productId, movementDate])
  @@index([tenantId, warehouseId, movementDate])
  @@index([tenantId, refType, refId])
  @@index([reversesId])
}

// =====================================================================
// SATIŞ MODÜLÜ MODELLERİ (FAZ 8)
// =====================================================================
//
// Satış + satış kalemleri.
// Onaylanan satış OTOMATİK olarak:
//   - 1 CustomerMovement (DEBIT) — müşteri borçlandırılır
//   - N StockMovement (OUT) — her kalem için stok çıkışı
//   - Ürün KDV dahil/hariç hesabı
//   - Grand total (subTotal + vatTotal - discountTotal)
// İptal edilen satış ise TERS kayıtlar (iade/iptal).
// =====================================================================

// SATIŞ
model Sale {
  id            String        @id @default(cuid())
  tenantId      String
  customerId    String
  saleNumber    String // "S-2026-0001" (tenant-scoped unique)
  saleDate      DateTime
  dueDate       DateTime? // Vade (açık hesap)
  type          SaleType      @default(SALE)
  status        SaleStatus    @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID)

  // Depo (satış hangi depodan yapıldı — stok çıkışı buradan olur)
  warehouseId String?

  // Fiyat bilgileri
  currency      String  @default("TRY")
  exchangeRate  Decimal @default(1)
  subTotal      Decimal @default(0) // KDV hariç toplam
  vatTotal      Decimal @default(0) // KDV toplamı
  discountTotal Decimal @default(0) // İskonto toplamı
  grandTotal    Decimal @default(0) // Genel toplam (KDV dahil)
  paidAmount    Decimal @default(0) // Ödenen tutar

  // Müşteri bilgileri (anlık snapshot — cari sonradan güncellenirse etkilenmez)
  customerName      String // Fatura anında
  customerTaxNumber String?
  customerAddress   String?
  customerPhone     String?
  customerEmail     String?

  notes         String?
  internalNotes String? // Sadece personelin göreceği notlar

  // Self-relation: iptal edilen satışın ID'si
  cancelsSaleId String? @unique

  isActive      Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?
  confirmedById String?
  confirmedAt   DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items       SaleItem[]
  collections Collection[]
  cancelsSale Sale?        @relation("SaleCancel", fields: [cancelsSaleId], references: [id], onDelete: SetNull)
  cancelledBy Sale?        @relation("SaleCancel")
  fromOrder   Order?       @relation("SaleFromOrder")

  @@unique([tenantId, saleNumber])
  @@index([tenantId, customerId, saleDate])
  @@index([tenantId, saleDate])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, type])
  @@index([cancelsSaleId])
}

// SATIŞ KALEMİ
model SaleItem {
  id           String         @id @default(cuid())
  tenantId     String
  saleId       String
  productId    String
  unitId       String?
  quantity     Decimal
  unitPrice    Decimal // Birim fiyat (KDV hariç)
  vatRate      Decimal // KDV oranı (ürünün KDV'si, snapshot)
  discountRate Decimal        @default(0) // Satır iskonto oranı (%)
  description  String? // Serbest metin açıklama (kalem bazlı)
  sortOrder    Int            @default(0)
  status       SaleItemStatus @default(ACTIVE)

  // Hesaplanmış alanlar (snapshot — uygulama katmanında set edilir)
  lineSubTotal   Decimal // quantity * unitPrice (iskonto hariç, KDV hariç)
  discountAmount Decimal @default(0) // İskonto tutarı
  lineVatAmount  Decimal @default(0) // KDV tutarı
  lineGrandTotal Decimal // KDV dahil toplam

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, saleId])
  @@index([tenantId, productId])
}

// -----------------------------------------------------------------------
// SİPARİŞ MODÜLÜ ENUMLARI (FAZ 9)
// -----------------------------------------------------------------------

enum OrderStatus {
  PENDING // Bekliyor (taslak)
  CONFIRMED // Onaylandı (satışa dönüştürülabilir)
  PARTIALLY_SHIPPED // Kısmi sevk
  SHIPPED // Sevk edildi
  DELIVERED // Teslim edildi
  COMPLETED // Tamamlandı (tam ödeme + teslimat)
  CANCELLED // İptal edildi
}

enum OrderType {
  SALES_ORDER // Satış siparişi
  PURCHASE_ORDER // Satın alma siparişi (gelecek faz)
  RETURN_ORDER // İade siparişi
  PROFORMA_ORDER // Proforma / teklif
  CONSIGNMENT_OUT // Konsinyasyon çıkış siparişi
}

// -----------------------------------------------------------------------
// SİPARİŞ MODÜLÜ MODELLERİ (FAZ 9)
// -----------------------------------------------------------------------
// Sipariş:
//   - Satış'ın "DRAFT" haline benzer ama sipariş/takip odaklı
//   - CONFIRMED → Sale'a dönüştürülebilir (fulfillment akışı)
//   - Depo/stok hareketi sipariş seviyesinde değil, Sale'a dönüşünce olur
// -----------------------------------------------------------------------

// SİPARİŞ
model Order {
  id           String      @id @default(cuid())
  tenantId     String
  orderNumber  String // "OR-2026-000001" (tenant-scoped unique)
  orderDate    DateTime
  deliveryDate DateTime? // Teslimat tarihi (taahhüt)
  type         OrderType   @default(SALES_ORDER)
  status       OrderStatus @default(PENDING)

  // Müşteri / Cari
  customerId        String
  customerName      String // Anlık kopya
  customerTaxNumber String?
  customerAddress   String?
  customerPhone     String?
  customerEmail     String?

  // Fiyat
  currency      String  @default("TRY")
  exchangeRate  Decimal @default(1)
  subTotal      Decimal @default(0)
  vatTotal      Decimal @default(0)
  discountTotal Decimal @default(0)
  grandTotal    Decimal @default(0)

  // Depo önerisi (opsiyonel)
  warehouseId   String?
  warehouseName String?

  // Dönüştürme
  linkedSaleId String? @unique // Bu siparişten oluşan satış

  notes         String?
  internalNotes String?

  // İlişkilendirme (iptal edilen sipariş)
  cancelsOrderId String? @unique

  isActive      Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?
  confirmedById String?
  confirmedAt   DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse    Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  linkedSale   Sale?       @relation("SaleFromOrder", fields: [linkedSaleId], references: [id], onDelete: SetNull)
  cancelsOrder Order?      @relation("OrderCancel", fields: [cancelsOrderId], references: [id], onDelete: SetNull)
  cancelledBy  Order?      @relation("OrderCancel")

  @@unique([tenantId, orderNumber])
  @@index([tenantId, customerId, orderDate])
  @@index([tenantId, orderDate])
  @@index([tenantId, type])
  @@index([tenantId, linkedSaleId])
  @@index([cancelsOrderId])
}

// SİPARİŞ KALEMİ
model OrderItem {
  id        String  @id @default(cuid())
  tenantId  String
  orderId   String
  productId String
  unitId    String?

  // Miktar ve fiyat
  quantity        Decimal
  quantityShipped Decimal        @default(0) // Teslim edilen (kısmi sevk)
  unitPrice       Decimal        @default(0) // KDV hariç birim fiyat
  vatRate         Decimal        @default(0)
  discountRate    Decimal        @default(0)
  description     String?
  sortOrder       Int            @default(0)
  status          SaleItemStatus @default(ACTIVE)

  // Hesaplanmış
  lineSubTotal   Decimal @default(0)
  discountAmount Decimal @default(0)
  lineVatAmount  Decimal @default(0)
  lineGrandTotal Decimal @default(0)

  // Kalem seviyesinde not
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, orderId])
  @@index([tenantId, productId])
  @@index([orderId, sortOrder])
}

// -----------------------------------------------------------------------
// TAHSİLAT MODÜLÜ ENUMS (FAZ 10)
// -----------------------------------------------------------------------

enum CollectionStatus {
  PENDING // Bekliyor
  CONFIRMED // Onaylandı (cari harekete dönüştü)
  CANCELLED // İptal edildi
  REFUNDED // İade edildi
}

enum CollectionType {
  CASH // Nakit tahsilat
  BANK_TRANSFER // EFT / HAVALE
  POS // Kredi kartı (POS)
  QR // QR kod / CepBank
  CHECK // Çek
  OTHER // Diğer
}

// -----------------------------------------------------------------------
// TAHSİLAT MODÜLÜ MODELLERİ (FAZ 10)
// -----------------------------------------------------------------------
// Tahsilat — borçlu cari hesabından para girişi.
// CONFIRMED durumunda OTOMATİK:
//   - 1 CustomerMovement (CREDIT) — müşteri alacaklandırılır
//   - 1 CashMovement (IN) — kasa/banka hesabı güncellenir
// İptal durumunda ters kayıt (COLLECTION_CANCEL → ters hareketler).
// -----------------------------------------------------------------------

// TAHSİLAT
model Collection {
  id               String   @id @default(cuid())
  tenantId         String
  collectionNumber String // "CL-2026-000001"
  collectionDate   DateTime

  // Cari (borçlu)
  customerId        String
  customerName      String // Anlık kopya
  customerTaxNumber String?

  type   CollectionType   @default(CASH)
  status CollectionStatus @default(PENDING)

  // Tutan
  amount       Decimal // Tahsil edilen tutar
  currency     String  @default("TRY")
  exchangeRate Decimal @default(1)

  // Referans (hangi satıştan tahsilat?)
  linkedSaleId  String?
  notes         String?
  internalNotes String?

  // İlişkilendirme (iptal edilen tahsilat)
  cancelsCollectionId String? @unique
  cashAccountId       String?

  isActive      Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?
  confirmedById String?
  confirmedAt   DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  linkedSale        Sale?        @relation(fields: [linkedSaleId], references: [id], onDelete: SetNull)
  cancelsCollection Collection?  @relation("CollectionCancel", fields: [cancelsCollectionId], references: [id], onDelete: SetNull)
  cancelledBy       Collection?  @relation("CollectionCancel")
  cashAccount       CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)

  cashMovements CashMovement[]

  @@unique([tenantId, collectionNumber])
  @@index([tenantId, customerId, collectionDate])
  @@index([tenantId, collectionDate])
  @@index([tenantId, type])
  @@index([tenantId, linkedSaleId])
  @@index([cancelsCollectionId])
}

// -----------------------------------------------------------------------
// DEPO TRANSFER MODÜLÜ (FAZ 14)
// -----------------------------------------------------------------------
// Depolar arası transfer — atomik OUT + IN (tek transaction).
// Reversal: silme yok, ters hareketler oluşturulur.
// -----------------------------------------------------------------------

// DEPO TRANSFERI
model WarehouseTransfer {
  id             String   @id @default(cuid())
  tenantId       String
  transferNumber String // "TR-2026-000001"
  transferDate   DateTime

  fromWarehouseId String
  toWarehouseId   String
  status          String @default("PENDING") // PENDING | CONFIRMED | CANCELLED

  description   String?
  notes         String?
  internalNotes String?

  isActive      Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?
  confirmedById String?
  confirmedAt   DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse               @relation(fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse               @relation("WarehouseTransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  items         WarehouseTransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId, transferDate])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

// DEPO TRANSFER KALEMI
model WarehouseTransferItem {
  id          String   @id @default(cuid())
  tenantId    String
  transferId  String
  productId   String
  unitId      String?
  quantity    Decimal
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transfer WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, transferId])
  @@index([transferId, sortOrder])
}

// -----------------------------------------------------------------------
// STOK SAYIM MODÜLÜ (FAZ 15)
// -----------------------------------------------------------------------
// Sayım: Depo bazlı stok sayımı. DRAFT → IN_PROGRESS → COMPLETED →
// PENDING_APPROVAL → APPROVED. APPROVED olunca otomatik ADJUST hareketi.
// Onaysız sayım cari/stok hareketi oluşturmaz.
// -----------------------------------------------------------------------

enum StockCountStatus {
  DRAFT // Taslak
  IN_PROGRESS // Devam ediyor (barkod okutuluyor)
  COMPLETED // Tamamlandı (henüz onaylanmadı)
  PENDING_APPROVAL // Onay için gönderildi
  APPROVED // Onaylandı (ADJUST hareketi oluştu)
  CANCELLED // İptal
}

enum StockCountType {
  FULL // Tüm ürünler
  PARTIAL // Sadece seçili ürünler
  CYCLE // Sayım turu (dönemsel)
  SPOT // Ani kontrol
  CATEGORY // Kategori bazlı
}

enum CountItemStatus {
  PENDING // Henüz sayılmadı
  COUNTED // Sayıldı
  SKIPPED // Atlandı
  RECOUNT_NEEDED // Yeniden sayım gerekli
}

// STOK SAYIMI
model StockCount {
  id          String           @id @default(cuid())
  tenantId    String
  countNumber String // "SC-2026-000001"
  warehouseId String
  name        String
  description String?
  countType   StockCountType   @default(FULL)
  status      StockCountStatus @default(DRAFT)

  // Sayım istatistikleri
  totalProducts   Int     @default(0)
  countedProducts Int     @default(0)
  differenceCount Int     @default(0) // Fark çıkan kalem sayısı
  totalDifference Decimal @default(0) // Toplam fark (mutlak)

  // Tarihler
  startedAt   DateTime?
  completedAt DateTime?
  approvedAt  DateTime?
  cancelledAt DateTime?

  // Kullanıcılar
  startedById   String?
  completedById String?
  approvedById  String?
  cancelledById String?

  notes         String?
  internalNotes String?

  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     StockCountItem[]

  @@unique([tenantId, countNumber])
  @@index([tenantId, warehouseId])
  @@index([tenantId, countType])
  @@index([tenantId, startedAt])
}

// SAYIM KALEMİ
model StockCountItem {
  id        String  @id @default(cuid())
  tenantId  String
  countId   String
  productId String
  unitId    String?

  // Miktarlar
  systemQuantity  Decimal // Sistemdeki kitap miktarı (sayım başında)
  countedQuantity Decimal? // Sayılan miktar (null ise henüz sayılmadı)
  difference      Decimal? // countedQuantity - systemQuantity (negatif = eksik)

  // Barkod ile sayım desteği
  barcode     String?
  countedById String?
  countedAt   DateTime?

  status    CountItemStatus @default(PENDING)
  sortOrder Int             @default(0)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  count   StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, countId])
  @@index([countId, status])
  @@index([tenantId, productId])
}

// =====================================================================
// İADE MODÜLÜ (FAZ 21)
// =====================================================================
//
// Satıştan veya siparişten geri alınan ürünler.
// Onaylanan iade:
//   - 1 CustomerMovement (CREDIT) — müşteri alacağı azalır/borcu artar
//   - N StockMovement (IN) — ürünler depoya geri döner (returnToStock=true ise)
// İptal edilen iade: TERS kayıtlar.
// =====================================================================

enum ReturnStatus {
  DRAFT
  PENDING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum ReturnReason {
  INTACT
  DEFECTIVE
  WRONG_PRODUCT
  EXCESS
  OTHER
}

enum ReturnSource {
  SALE
  ORDER
  DIRECT
}

enum ReturnItemCondition {
  INTACT
  DEFECTIVE
  DAMAGED
}

model Return {
  id           String       @id @default(cuid())
  tenantId     String
  returnNumber String // "IADE-2026-0001" (tenant-scoped unique)
  returnDate   DateTime
  customerId   String
  source       ReturnSource @default(DIRECT)
  sourceId     String? // Sale.id veya Order.id

  reason ReturnReason @default(OTHER)
  status ReturnStatus @default(DRAFT)

  // Müşteri snapshot
  customerName      String
  customerTaxNumber String?
  customerAddress   String?
  customerPhone     String?

  // Tutar
  currency      String  @default("TRY")
  exchangeRate  Decimal @default(1)
  subTotal      Decimal @default(0)
  vatTotal      Decimal @default(0)
  discountTotal Decimal @default(0)
  grandTotal    Decimal @default(0)

  // Stok etkisi
  returnToStock Boolean @default(true)

  // Notlar
  notes           String?
  internalNotes   String?
  rejectionReason String?

  // Soft delete + audit
  isActive      Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?
  approvedById  String?
  approvedAt    DateTime?
  completedById String?
  completedAt   DateTime?
  rejectedById  String?
  rejectedAt    DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    ReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId, customerId, returnDate])
  @@index([tenantId, source, sourceId])
}

// =====================================================================
// ALIŞ FATURASI MODÜLÜ
// =====================================================================
// Tedarikçiden yapılan alımlar için alış faturaları.
// Onaylanan alış faturası OTOMATİK olarak:
//   - 1 CustomerMovement (CREDIT) — tedarikçiye borç kaydı
//   - N StockMovement (IN) — ürünler depoya girer (warehouseId)
// İptal edilen alış faturası: TERS kayıtlar.
// =====================================================================

enum PurchaseInvoiceStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum PurchaseInvoiceType {
  PURCHASE
  RETURN
}

model PurchaseInvoice {
  id          String                @id @default(cuid())
  tenantId    String
  supplierId  String // Tedarikçi (Customer)
  invoiceNumber String // "AF-2026-000001" (tenant-scoped unique)
  invoiceDate DateTime
  dueDate     DateTime? // Vade

  type   PurchaseInvoiceType      @default(PURCHASE)
  status PurchaseInvoiceStatus    @default(DRAFT)
  paymentStatus PaymentStatus     @default(UNPAID)

  // Depo (stok girişi hangi depoya yapılacak)
  warehouseId String

  // Fiyat bilgileri
  currency      String  @default("TRY")
  exchangeRate  Decimal @default(1)
  subTotal      Decimal @default(0) // KDV hariç toplam
  vatTotal      Decimal @default(0) // KDV toplamı
  discountTotal Decimal @default(0) // İskonto toplamı
  grandTotal    Decimal @default(0) // Genel toplam (KDV dahil)
  paidAmount    Decimal @default(0) // Ödenen tutar

  // Tedarikçi bilgileri (anlık snapshot)
  supplierName      String
  supplierTaxNumber String?
  supplierAddress   String?
  supplierPhone     String?
  supplierEmail     String?

  // E-fatura bilgileri (opsiyonel)
  einvoiceNumber String?
  einvoiceStatus String?
  einvoiceDate   DateTime?

  notes         String?
  internalNotes String?

  // Self-relation: iptal edilen faturaya referans
  cancelsInvoiceId String? @unique

  isActive      Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?
  confirmedById String?
  confirmedAt   DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier    Customer             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse   Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items       PurchaseInvoiceItem[]
  cancelsInvoice PurchaseInvoice?  @relation("PurchaseInvoiceCancel", fields: [cancelsInvoiceId], references: [id], onDelete: SetNull)
  cancelledBy PurchaseInvoice?     @relation("PurchaseInvoiceCancel")

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, supplierId, invoiceDate])
  @@index([tenantId, invoiceDate])
  @@index([tenantId, status])
  @@index([tenantId, paymentStatus])
  @@index([cancelsInvoiceId])
}

model PurchaseInvoiceItem {
  id          String         @id @default(cuid())
  tenantId    String
  invoiceId   String
  productId   String
  unitId      String?
  quantity    Decimal
  unitPrice   Decimal // Birim fiyat (KDV hariç)
  vatRate     Decimal // KDV oranı (%)
  discountRate Decimal       @default(0) // Satır iskonto oranı (%)
  description String? // Serbest metin açıklama
  sortOrder   Int            @default(0)
  status      SaleItemStatus @default(ACTIVE)

  // Hesaplanmış alanlar
  lineSubTotal   Decimal // quantity * unitPrice
  discountAmount Decimal @default(0)
  lineVatAmount  Decimal @default(0)
  lineGrandTotal Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice PurchaseInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, invoiceId])
  @@index([tenantId, productId])
}

model ReturnItem {
  id        String  @id @default(cuid())
  tenantId  String
  returnId  String
  productId String
  unitId    String?

  quantity     Decimal
  unitPrice    Decimal // KDV hariç
  vatRate      Decimal             @default(0)
  discountRate Decimal             @default(0)
  condition    ReturnItemCondition @default(INTACT)
  description  String?
  sortOrder    Int                 @default(0)

  // Hesaplanmış
  lineSubTotal   Decimal
  lineVatAmount  Decimal @default(0)
  lineGrandTotal Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  return  Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, returnId])
  @@index([tenantId, productId])
}

// =====================================================================
// BANKA & POS MODÜLÜ (FAZ 22)
// =====================================================================
//
// Banka hesapları, POS cihazları, banka hareketleri, POS tahsilatları.
// Event-sourced: bakiye = SUM(transactions) WHERE sign
// =====================================================================

enum BankAccountStatus {
  ACTIVE
  PASSIVE
  BLOCKED
}

enum BankAccountType {
  CHECKING
  SAVINGS
  FOREIGN_CURRENCY
  POS
}

enum BankTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  FEE
  COLLECTION
  PAYMENT
  POS_COLLECTION
  INTEREST
  OTHER
}

enum PosStatus {
  ACTIVE
  PASSIVE
}

enum PosCollectionStatus {
  PENDING
  SETTLED
  REVERSED
  PARTIAL
}

model BankAccount {
  id            String            @id @default(cuid())
  tenantId      String
  bankName      String
  accountName   String
  iban          String?           @db.VarChar(34)
  accountNumber String?
  currency      String            @default("TRY")
  type          BankAccountType   @default(CHECKING)
  status        BankAccountStatus @default(ACTIVE)
  branchCode    String?
  branchName    String?
  notes         String?
  isDefault     Boolean           @default(false)

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions   BankTransaction[] @relation("BankAccountTxns")
  counterTxns    BankTransaction[] @relation("BankAccountCounter")
  posDevices     PosDevice[]
  posCollections PosCollection[]

  @@unique([tenantId, iban])
  @@index([tenantId, type])
  @@index([tenantId, isDeleted])
}

model BankTransaction {
  id                   String              @id @default(cuid())
  tenantId             String
  bankAccountId        String
  txnDate              DateTime
  type                 BankTransactionType
  amount               Decimal // Pozitif = giriş, negatif = çıkış
  currency             String              @default("TRY")
  exchangeRate         Decimal             @default(1)
  amountTry            Decimal // TL karşılığı
  customerId           String?
  counterBankAccountId String?

  posCollectionId String?
  description     String?
  refType         String?
  refId           String?
  refNumber       String?
  isReconciled    Boolean   @default(false)
  reconciledAt    DateTime?
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdById     String?
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankAccount        BankAccount    @relation("BankAccountTxns", fields: [bankAccountId], references: [id], onDelete: Restrict)
  counterBankAccount BankAccount?   @relation("BankAccountCounter", fields: [counterBankAccountId], references: [id], onDelete: SetNull)
  posCollection      PosCollection? @relation(fields: [posCollectionId], references: [id], onDelete: SetNull)

  @@index([tenantId, bankAccountId, txnDate])
  @@index([tenantId, type])
  @@index([tenantId, customerId])
  @@index([tenantId, txnDate])
  @@index([tenantId, isDeleted])
}

model PosDevice {
  id             String    @id @default(cuid())
  tenantId       String
  bankAccountId  String
  name           String
  posCode        String
  commissionRate Decimal   @default(0) // %
  blockDays      Int       @default(1)
  status         PosStatus @default(ACTIVE)
  notes          String?

  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankAccount BankAccount     @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  collections PosCollection[]

  @@unique([tenantId, posCode])
  @@index([tenantId, isDeleted])
}

model PosCollection {
  id             String   @id @default(cuid())
  tenantId       String
  posDeviceId    String
  bankAccountId  String
  collectionDate DateTime
  customerId     String?
  customerName   String?

  amount         Decimal // Brüt
  commission     Decimal             @default(0) // Komisyon tutarı
  netAmount      Decimal // Net (amount - commission)
  installment    Int                 @default(1)
  currency       String              @default("TRY")
  status         PosCollectionStatus @default(PENDING)
  settlementDate DateTime? // Hesaba geçeceği tarih
  description    String?
  refType        String?
  refId          String?
  isDeleted      Boolean             @default(false)
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posDevice        PosDevice         @relation(fields: [posDeviceId], references: [id], onDelete: Restrict)
  bankAccount      BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  bankTransactions BankTransaction[]

  @@index([tenantId, posDeviceId, collectionDate])
  @@index([tenantId, bankAccountId, collectionDate])
  @@index([tenantId, customerId])
  @@index([tenantId, isDeleted])
}

// =====================================================================
// VERİ TAŞIMA / GEÇİŞ MODÜLÜ (FAZ 24)
// =====================================================================
//
// Excel/CSV/SQL/XML kaynaklardan veri aktarımı.
// Satış geçmişi sadece arşiv amaçlı (cari/stok bakiyesi ETKİLENMEZ).
// Aktarım sonrası soft delete + audit log ile geri alınabilir.
// =====================================================================

enum ImportSource {
  EXCEL
  CSV
  XML
  MIKRO
  LOGO
  NETSIS
  PARASUT
  CUSTOM_SQL
  MANUAL
}

enum ImportEntityType {
  CUSTOMER
  PRODUCT
  PRICE
  BARCODE
  WAREHOUSE
  CUSTOMER_BALANCE
  STOCK_BALANCE
  ARCHIVE_SALE
}

enum ImportStatus {
  DRAFT
  MAPPING
  PREVIEW
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  ROLLED_BACK
}

model ImportBatch {
  id         String           @id @default(cuid())
  tenantId   String
  name       String
  source     ImportSource
  entityType ImportEntityType
  status     ImportStatus     @default(DRAFT)

  // Kaynak dosya
  fileName String?
  fileSize Int?
  rowCount Int     @default(0)

  // Kolon eşleştirme
  columnMapping Json? // { "kaynak_kolon": "hedef_alan" }

  // Sonuç
  successCount   Int @default(0)
  errorCount     Int @default(0)
  duplicateCount Int @default(0)

  // Audit
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdById  String?
  startedAt    DateTime?
  completedAt  DateTime?
  rolledBackAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rows   ImportRow[]

  @@index([tenantId, entityType])
  @@index([tenantId, createdAt])
  @@index([tenantId, isDeleted])
}

model ImportRow {
  id           String       @id @default(cuid())
  tenantId     String
  batchId      String
  rowNumber    Int
  sourceData   Json // Ham satır verisi
  mappedData   Json? // Eşleştirilmiş veri
  status       ImportStatus @default(DRAFT) // DRAFT | COMPLETED | FAILED
  errorMessage String?
  createdRefId String? // Oluşturulan kayıt ID (örn: customerId)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch  ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId, batchId, status])
}

// =====================================================================
// API & WEBHOOK MODÜLÜ (FAZ 25)
// =====================================================================
//
// 3rd party entegrasyonlar için API anahtarları ve webhook'lar.
// Secret-key'ler SHA-256 hash'lenerek saklanır (asla plain text değil).
// =====================================================================

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum WebhookStatus {
  ACTIVE
  PAUSED
  FAILED
  REVOKED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
  ABANDONED
}

model ApiKey {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  keyHash     String       @unique // SHA-256(full_key)
  keyPrefix   String // "saas_live_abc123" (gösterim)
  keyHint     String // "xyz4" (son 4)
  scopes      String[] // ["customers:read", ...]
  status      ApiKeyStatus @default(ACTIVE)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isDeleted   Boolean      @default(false)
  deletedAt   DateTime?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usageLogs ApiKeyUsageLog[]

  @@index([tenantId, isDeleted])
}

model ApiKeyUsageLog {
  id         String   @id @default(cuid())
  tenantId   String
  apiKeyId   String
  endpoint   String
  method     String
  statusCode Int
  duration   Int // ms
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([tenantId, apiKeyId, createdAt])
  @@index([tenantId, statusCode])
}

model Webhook {
  id                 String                 @id @default(cuid())
  tenantId           String
  name               String
  url                String
  events             String[] // ["order.created", ...]
  status             WebhookStatus          @default(ACTIVE)
  secretHash         String // SHA-256
  secretPrefix       String // "whsec_xxxx"
  successCount       Int                    @default(0)
  failureCount       Int                    @default(0)
  lastDeliveryAt     DateTime?
  lastDeliveryStatus WebhookDeliveryStatus?
  isDeleted          Boolean                @default(false)
  deletedAt          DateTime?
  createdById        String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId, isDeleted])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  tenantId       String
  webhookId      String
  eventType      String
  payload        Json
  responseStatus Int?
  responseBody   String?
  duration       Int?
  attempt        Int                   @default(1)
  status         WebhookDeliveryStatus @default(PENDING)
  errorMessage   String?
  deliveredAt    DateTime              @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([tenantId, webhookId, deliveredAt])
  @@index([tenantId, eventType])
}

