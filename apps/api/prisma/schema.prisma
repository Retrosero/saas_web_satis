// Prisma schema — SaaS İşletme Yönetim Platformu
// Veritabanı: PostgreSQL 16
//
// Bu şema FAZ 1 (proje iskeleti) kapsamındadır.
// Tüm tenant'lı tablolarda ortak alanlar: id, tenant_id, is_active, is_deleted,
// created_at, updated_at, created_by, updated_by, deleted_at, deleted_by.
// ERP entegrasyonu açık tablolarda ek: source_system, external_id, sync_status vs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  PENDING
  CANCELLED
}

enum WorkingMode {
  SAAS_MASTER
  ERP_MASTER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING
}

enum DataScope {
  OWN
  BRANCH
  TENANT
}

enum TenantModuleSource {
  plan
  manual_override
}

enum PlanCode {
  starter
  standard
  professional
  enterprise
  custom
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ModuleCategory {
  core
  operations
  finance
  hr
  integration
  addon
}

enum PermissionAction {
  view
  read
  create
  update
  delete
  export
  import
  print
  approve
  cancel
  manage
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SyncStatus {
  SYNCED
  PENDING
  CONFLICT
  IGNORED
}

enum SourceSystem {
  SAAS
  MICRO
  LOGO
  NETSIS
  PARASUT
  OTHER
}

// =====================================================================
// SAAS ÇEKİRDEK TABLOLAR
// =====================================================================

model Tenant {
  id              String        @id @default(cuid())
  code            String        @unique
  name            String
  workingMode     WorkingMode   @default(SAAS_MASTER)
  status          TenantStatus  @default(TRIAL)
  isActive        Boolean       @default(true)
  isDeleted       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  deletedBy       String?

  settings        TenantSettings?
  users           User[]
  roles           Role[]
  subscriptions   Subscription[]
  tenantModules   TenantModule[]
  auditLogs       AuditLog[]
  errorLogs       ErrorLog[]
  securityLogs    SecurityLog[]
  notifications   Notification[]

  @@index([status])
  @@index([isDeleted])
}

model TenantSettings {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  companyInfo         Json     @default("{}")
  currency            String   @default("TRY")
  locale              String   @default("tr-TR")
  taxOffice           String?
  taxNumber           String?
  defaultWarehouseId  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id            String        @id @default(cuid())
  tenantId      String?
  email         String
  phone         String?
  passwordHash  String
  fullName      String
  avatarUrl     String?
  status        UserStatus    @default(ACTIVE)
  mfaEnabled    Boolean       @default(false)
  lastLoginAt   DateTime?
  isActive      Boolean       @default(true)
  isDeleted     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  deletedBy     String?

  tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]    @relation("AuditLogUser")
  securityLogs  SecurityLog[] @relation("SecurityLogUser")
  notifications Notification[] @relation("NotificationUser")

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId, isDeleted])
}

model Role {
  id            String           @id @default(cuid())
  tenantId      String?
  code          String
  name          String
  description   String?
  isSystem      Boolean          @default(false)
  isActive      Boolean          @default(true)
  isDeleted     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant        Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  userRoles     UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  module      String
  resource    String
  action      PermissionAction
  description String?
  createdAt   DateTime         @default(now())

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String
  roleId     String
  tenantId   String
  dataScope  DataScope @default(TENANT)
  branchIds  String[]  @default([])
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId])
  @@index([tenantId])
}

model Module {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  category      ModuleCategory
  defaultRoute  String
  icon          String
  sortOrder     Int           @default(100)
  description   String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  planModules   PlanModule[]
  tenantModules TenantModule[]
}

model Plan {
  id              String       @id @default(cuid())
  code            PlanCode     @unique
  name            String
  description     String?
  monthlyPrice    Decimal      @default(0) @db.Decimal(10, 2)
  yearlyPrice     Decimal      @default(0) @db.Decimal(10, 2)
  currency        String       @default("TRY")
  userLimit       Int          @default(0)
  branchLimit     Int          @default(0)
  warehouseLimit  Int          @default(0)
  apiKeyLimit     Int          @default(0)
  webhookLimit    Int          @default(0)
  storageMbLimit  Int          @default(0)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  planModules     PlanModule[]
  subscriptions   Subscription[]
}

model PlanModule {
  id           String  @id @default(cuid())
  planId       String
  moduleId     String
  isIncluded   Boolean @default(true)
  customLimit  Json?
  plan         Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  module       Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
}

model TenantModule {
  id            String              @id @default(cuid())
  tenantId      String
  moduleId      String
  isActive      Boolean             @default(true)
  source        TenantModuleSource  @default(plan)
  limitOverride Json?
  validUntil    DateTime?
  note          String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module        Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@index([tenantId, isActive])
}

model Subscription {
  id          String             @id @default(cuid())
  tenantId    String
  planId      String
  status      SubscriptionStatus @default(TRIAL)
  startAt     DateTime           @default(now())
  endAt       DateTime?
  trialEndAt  DateTime?
  autoRenew   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        Plan               @relation(fields: [planId], references: [id])

  @@index([tenantId, status])
  @@index([endAt])
}

// =====================================================================
// AUTH YARDIMCI
// =====================================================================

model RefreshToken {
  id            String   @id @default(cuid())
  userId        String
  tokenHash     String   @unique
  tenantId      String
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime @default(now())
  userAgent     String?
  ipAddress     String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// =====================================================================
// LOG TABLOLARI
// =====================================================================

model AuditLog {
  id           String     @id @default(cuid())
  tenantId     String?
  userId       String?
  module       String
  action       String
  entityType   String
  entityId     String?
  oldValues    Json?
  newValues    Json?
  changedFields String[]  @default([])
  ipAddress    String?
  userAgent    String?
  requestId    String?
  riskLevel    RiskLevel  @default(LOW)
  createdAt    DateTime   @default(now())

  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user         User?      @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([riskLevel])
}

model ErrorLog {
  id          String   @id @default(cuid())
  tenantId    String?
  userId      String?
  level       String   @default("ERROR")
  message     String
  stackTrace  String?
  path        String?
  method      String?
  statusCode  Int?
  requestId   String?
  createdAt   DateTime @default(now())

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([level])
}

model SecurityLog {
  id          String   @id @default(cuid())
  tenantId    String?
  userId      String?
  event       String
  ipAddress   String?
  userAgent   String?
  riskLevel   RiskLevel @default(LOW)
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user        User?    @relation("SecurityLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([event])
}

// =====================================================================
// BİLDİRİM SİSTEMİ
// =====================================================================

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
}

enum NotificationCategory {
  SYSTEM
  SECURITY
  TENANT
  PLAN
  MODULE
  USER
  SALE
  COLLECTION
  STOCK
  ORDER
  INVOICE
  REPORT
}

model Notification {
  id          String              @id @default(cuid())
  tenantId    String?
  userId      String?              // null = tenant'taki tüm kullanıcılara
  type        NotificationType    @default(INFO)
  category    NotificationCategory @default(SYSTEM)
  title       String
  message     String
  link        String?              // frontend'de gidilecek sayfa
  metadata    Json?
  isRead      Boolean             @default(false)
  readAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())

  tenant      Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?               @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([userId, isRead])
  @@index([tenantId, isRead])
  @@index([category])
  @@index([expiresAt])
}
