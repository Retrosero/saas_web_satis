enum HrOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_DOCS
  COMPLETED
  CANCELLED
}

enum HrOnboardingItemStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
  NOT_APPLICABLE
}

model HrOnboardingChecklist {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  startDate   DateTime
  targetCompletionDate DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  status      HrOnboardingStatus @default(NOT_STARTED)
  notes       String?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  deletedBy   String?

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items       HrOnboardingChecklistItem[]

  @@index([tenantId, isDeleted])
  @@index([tenantId, employeeId])
}

model HrOnboardingChecklistItem {
  id            String   @id @default(cuid())
  tenantId      String
  checklistId   String
  itemKey       String   // 'identity_info', 'contract_uploaded', etc.
