  SALESPERSON
}

model NotificationChannel {
  id          String                  @id @default(cuid())
  tenantId    String
  name        String
  type        NotificationChannelType
  description String?
  config      Json                    @default("{}")
  // EMAIL: { smtpHost, smtpPort, smtpUser, smtpPassword(fromSecret), fromAddress, fromName, useTls }
  // SMS: { provider, apiKey(fromSecret), fromNumber }
  // WEBHOOK: { url, method, headers, authType, authConfig }
  isActive    Boolean                 @default(true)
  isDefault   Boolean                 @default(false)
  testStatus  String? // null | 'OK' | 'FAILED'
  testAt      DateTime?
  testError   String?
  createdById String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  isDeleted   Boolean                 @default(false)
  deletedAt   DateTime?

  tenant  Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules   NotificationRuleChannel[]
  logs    NotificationLog[]
  secrets NotificationChannelSecret[]

  @@index([tenantId, isDeleted])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
}

model NotificationChannelSecret {
  id        String   @id @default(cuid())
  channelId String
  key       String // smtpPassword / apiKey / etc
  value     String // plain — tenant şifreleme katmanı ileride
  createdAt DateTime @default(now())

  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

model NotificationRule {
  id              String                  @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  triggerType     NotificationTriggerType
  conditions      Json                    @default("[]")
  // [{ field, operator, value }] - trigger sonrası entity üzerinde filtre
  actions         Json                    @default("[]")
  // [{ type, template, payload }]
  recipients      Json                    @default("[]")
  // [{ type, targetIds, roleIds }]
  channels        Json                    @default("[]")
  // [channelId1, channelId2] - hangi kanallara gönderilecek
  priority        Int                     @default(5) // 1-10
  isActive        Boolean                 @default(true)
  cooldownMinutes Int                     @default(0) // aynı rule kaç dakika içinde tekrar tetiklenmesin
  lastTriggeredAt DateTime?
  triggerCount    Int                     @default(0)
  // Kategori bazlı özel ayarlar
  settings        Json                    @default("{}")
  // LOW_STOCK: { thresholdMode: 'PRODUCT'|'WAREHOUSE' }
  // PAYMENT_DUE: { daysBeforeDue: [7, 3, 0] }
  // SALE_OVER_LIMIT: { amountLimit: 50000 }
  createdById     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  isDeleted       Boolean                 @default(false)
  deletedAt       DateTime?

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ruleChannels NotificationRuleChannel[]
  logs         NotificationLog[]

  @@index([tenantId, isActive])
  @@index([tenantId, triggerType])
  @@index([tenantId, isDeleted])
  @@index([lastTriggeredAt])
}

model NotificationRuleChannel {
  ruleId    String
  channelId String

  rule    NotificationRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([ruleId, channelId])
}

model NotificationLog {
  id               String                    @id @default(cuid())
  tenantId         String
  ruleId           String?
  channelId        String?
  triggerType      NotificationTriggerType
  recipientType    NotificationRecipientType
  recipientId      String? // userId / customerId / etc
  recipientName    String?
  recipientContact String? // email/phone/webhook URL
  subject          String?
  body             String
  payload          Json                      @default("{}")
  status           NotificationLogStatus     @default(PENDING)
  attempts         Int                       @default(0)
  lastAttemptAt    DateTime?
  sentAt           DateTime?
  failedAt         DateTime?
  error            String?
  durationMs       Int?
  metadata         Json                      @default("{}")
  createdAt        DateTime                  @default(now())

  tenant  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule    NotificationRule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  channel NotificationChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([ruleId, createdAt])
  @@index([channelId, createdAt])
  @@index([recipientId])
}

model NotificationPreferences {
  id         String   @id @default(cuid())
  userId     String   @unique
  tenantId   String
  channels   Json     @default("{}")
  // { inApp: true, email: true, sms: false, emailAddress, phone }
  categories Json     @default("{}")
  // { SALE: true, COLLECTION: true, LOW_STOCK: true, ... }
  quietHours Json     @default("{}")
  // { enabled: false, startTime: "22:00", endTime: "08:00" }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
}

