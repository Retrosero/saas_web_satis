  notes         String?
  documentId    String?  // bağlı evrak (HrEmployeeDocument.id)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  checklist     HrOnboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([tenantId, checklistId])
  @@index([tenantId, itemKey])
}

model HrOffboardingChecklist {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  terminationDate DateTime
  reason      String?
  completedAt DateTime?
  cancelledAt DateTime?
  status      HrOnboardingStatus @default(NOT_STARTED)
  notes       String?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  deletedBy   String?

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items       HrOffboardingChecklistItem[]

  @@index([tenantId, isDeleted])
  @@index([tenantId, employeeId])
}

model HrOffboardingChecklistItem {
  id            String   @id @default(cuid())
  tenantId      String
  checklistId   String
  itemKey       String
  title         String
  description   String?
  isRequired    Boolean  @default(true)
  isCompleted   Boolean  @default(false)
  completedAt   DateTime?
  completedBy   String?
  status        HrOnboardingItemStatus @default(PENDING)
  notes         String?
  documentId    String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  checklist     HrOffboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([tenantId, checklistId])
  @@index([tenantId, itemKey])
}

// ============================================================================
// FAZ HR-3: İzin Yönetimi
// ============================================================================

enum HrLeaveTypeCode {
  ANNUAL       // Yıllık ücretli izin
  WEEKLY       // Haftalık izin
  UNPAID       // Ücretsiz izin
  MATERNITY    // Doğum izni
  PATERNITY    // Babalık izni
  SICK         // Hastalık izni
  DEATH        // Ölüm izni
  EXCUSE       // Mazeret izni
  COMPENSATION // Fazla mesai izinleri (ücretsiz)
  MARRIAGE     // Evlilik izni
}

enum HrLeaveAccrualMethod {
  STANDARD  // Yıl başında tam hak
  MONTHLY   // Her ay eşit birikir
  NONE      // Sınırsız (ücretsiz gibi)
}

enum HrLeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model HrLeaveType {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  code              HrLeaveTypeCode
  color             String   @default("#6B7280")
  icon              String   @default("📋")
  accrualMethod     HrLeaveAccrualMethod @default(STANDARD)
  defaultDaysPerYear Int     @default(0)
  requiresApproval  Boolean  @default(true)
  requiresDocument  Boolean  @default(false)
  minDaysNotice     Int      @default(0)
  maxConsecutiveDays Int     @default(0)
  canCarryOver      Boolean  @default(false)
  carryOverDays    Int      @default(0)
  isPaid           Boolean  @default(true)
  isActive          Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isDeleted         Boolean  @default(false)
  deletedAt         DateTime?

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveBalances     HrLeaveBalance[]
  leaveRequests     HrLeaveRequest[]
  leaveAdjustments HrLeaveAdjustment[]

  @@index([tenantId, isActive])
  @@index([tenantId, code])
}

model HrLeaveBalance {
  id            String   @id @default(cuid())
  tenantId      String
  employeeId    String
  leaveTypeId   String
  year          Int
  entitledDays  Decimal  @default(0)
  accruedDays   Decimal  @default(0)
  usedDays      Decimal  @default(0)
  pendingDays   Decimal  @default(0)
  carriedOverDays Int    @default(0)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee      HrEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     HrLeaveType  @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, leaveTypeId, year])
  @@index([tenantId, employeeId, year])
}

model HrLeaveRequest {
  id                     String   @id @default(cuid())
  tenantId               String
  employeeId             String
  leaveTypeId            String
  startDate              DateTime
  endDate                DateTime
  totalDays              Decimal
  workingDays            Decimal
  reason                 String?
  status                 HrLeaveRequestStatus @default(PENDING)
  approverId             String?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?
  documentUrl            String?
  replacementEmployeeId  String?
  cancellationReason     String?
  createdBy              String
  updatedBy              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  isDeleted              Boolean  @default(false)
  deletedAt              DateTime?

  tenant                Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee              HrEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType             HrLeaveType  @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  approver              User?        @relation("LeaveRequestApprover", fields: [approverId], references: [id])

  @@index([tenantId, employeeId, status])
  @@index([tenantId, status, startDate])
  @@index([approverId, status])
}

model HrLeaveAdjustment {
  id            String   @id @default(cuid())
  tenantId      String
  employeeId     String
  leaveTypeId   String
  year          Int
  adjustment    Decimal
  reason        String
  adjustedBy    String
  createdAt     DateTime @default(now())

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee      HrEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     HrLeaveType  @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, year])
}

// =====================================================================
// HR-4: BORDRO HAZIRLIK
// Muhasebeye gönderilecek bordro dökümleri (hesaplama müşteri/muhasebe tarafından yapılır)
// =====================================================================

enum PayrollPeriodType {
  MONTHLY  // Aylık
  WEEKLY   // Haftalık
}

enum PayrollPeriodStatus {
  DRAFT      // Taslak
  REVIEW     // İncelemede
  CONFIRMED  // Onaylandı
  EXPORTED   // Dışa aktarıldı (muhasebeye gönderildi)
  CLOSED     // Kapatıldı
}

enum PayrollRecordStatus {
  DRAFT     // Veri girişi
  REVIEW    // İnceleme
  CONFIRMED // Kesinleşti
  EXPORTED  // Dışa aktarıldı
}

enum SupplementType {
  BONUS          // Prim
  INCENTIVE      // Teşvik/İkramiye
  ALLOWANCE      // Ek ödeme/Allowance
  DEDUCTION      // Kesinti
  SOCIAL_SEC     // SGK kesintisi
  TAX            // Vergi kesintisi
  OTHER          // Diğer
}

model HrPayrollPeriod {
  id            String   @id @default(cuid())
  tenantId      String
  year          Int      // 2025
  period        Int      // 1-12 (aylık) veya 1-52 (haftalık)
  periodType    PayrollPeriodType @default(MONTHLY)
  startDate     DateTime
  endDate       DateTime
  status        PayrollPeriodStatus @default(DRAFT)
  totalGross    Decimal?  @db.Decimal(15,2)
  totalNet      Decimal?  @db.Decimal(15,2)
  employeeCount Int?
  confirmedBy   String?
  confirmedAt   DateTime?
  exportedBy    String?
  exportedAt    DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records        HrPayrollRecord[]
  supplements    HrPayrollSupplement[]

  @@unique([tenantId, year, period, periodType])
  @@index([tenantId, year])
  @@index([tenantId, status])
}

model HrPayrollRecord {
  id                 String   @id @default(cuid())
  tenantId           String
  periodId           String
  employeeId         String
  workingDays        Decimal  @default(0) @db.Decimal(5,2)
  absentDays         Decimal  @default(0) @db.Decimal(5,2)
  overtimeHours      Decimal  @default(0) @db.Decimal(8,2)
  lateHours          Decimal  @default(0) @db.Decimal(8,2)
  baseSalary         Decimal  @db.Decimal(15,2)
  grossPay           Decimal  @default(0) @db.Decimal(15,2)
  sgkEmployee        Decimal  @default(0) @db.Decimal(15,2)
  unemploymentEmployee Decimal @default(0) @db.Decimal(15,2)
  incomeTax          Decimal  @default(0) @db.Decimal(15,2)
  netPay             Decimal  @default(0) @db.Decimal(15,2)
  status             PayrollRecordStatus @default(DRAFT)
  exportedAt         DateTime?
  exportedBy         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?
  updatedBy          String?

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period      HrPayrollPeriod    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee    HrEmployee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  supplements HrPayrollSupplement[]

  @@unique([tenantId, periodId, employeeId])
  @@index([tenantId, periodId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

model HrPayrollSupplement {
  id          String   @id @default(cuid())
  tenantId    String
  periodId    String
  employeeId  String
  recordId    String?
  type        SupplementType
  name        String
  amount      Decimal  @db.Decimal(15,2)
  isDeduction Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period  HrPayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee HrEmployee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  record  HrPayrollRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@index([tenantId, periodId])
  @@index([tenantId, employeeId])
  @@index([tenantId, type])
}

// =====================================================================
// HR-5: BORDRO PARAMETRELERİ & KESENEK
// SGK kesenek oranları, vergi dilimleri, asgari ücret, bordro parametreleri
// =====================================================================

model HrPayrollParam {
  id          String   @id @default(cuid())
  tenantId    String
  year        Int      // 2025, 2026...
  paramKey    String   // "sgk_employee_rate", "min_wage", "agc_exemption_limit"...
  paramValue  Decimal  @db.Decimal(15,4)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year, paramKey])
  @@index([tenantId, year])
}

// =====================================================================
// HR-6: DEVAMSIZLIK & DİSİPLİN
// =====================================================================

enum AbsenceType {
  UNPAID_LEAVE    // Ücretsiz izin
  SICK            // Hastalık (devamsızlık)
  UNAUTHORIZED    // İzinsiz devamsızlık
  LATE            // Geç kalma
  EARLY_LEAVE     // Erken çıkış
  OTHER           // Diğer
}

enum DisciplinaryActionType {
  WARNING           // Uyarı
  SUSPENSION        // Tecil/mesai durdurma
  SALARY_CUT        // Maaş kesintisi
  TERMINATION       // İşten çıkarma
  OTHER             // Diğer
}

model HrAbsenceRecord {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId   String
  absenceType  AbsenceType
  startDate    DateTime
  endDate      DateTime
  totalDays    Decimal  @db.Decimal(5,2)
  reason       String?
  isJustified  Boolean  @default(false)  // Mazeretli devamsızlık
  deductionAmount Decimal @default(0) @db.Decimal(15,2) // Kesinti tutarı
  periodId     String?  // Hangi bordro döneminde kesinti yapıldı
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee HrEmployee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, startDate])
  @@index([tenantId, absenceType])
}

model HrDisciplinaryCase {
  id            String   @id @default(cuid())
  tenantId      String
  employeeId    String
  caseNo        String   // "DISC-2025-001"
  incidentDate  DateTime
  incidentDesc  String
  actionType    DisciplinaryActionType
  actionDate    DateTime?
  actionNotes   String?
  isClosed      Boolean  @default(false)
  closedBy      String?
  closedAt      DateTime?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee HrEmployee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, caseNo])
  @@index([tenantId, employeeId])
  @@index([tenantId, actionType])
  @@index([tenantId, isClosed])
}

// =====================================================================
// HR-7: KARİYER & EĞİTİM & PERFORMANS
// =====================================================================

model HrCareerRecord {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  recordType  String   // "PROMOTION", "TRANSFER", "SALARY_CHANGE", "TITLE_CHANGE"
  effectiveDate DateTime
  oldValue    String?  // Önceki değer
  newValue    String?  // Yeni değer
  notes       String?
  approvedBy  String?
  createdAt   DateTime @default(now())

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee HrEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, recordType])
  @@index([tenantId, effectiveDate])
}

model HrTraining {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  trainer         String?
  startDate       DateTime
  endDate         DateTime
  location        String?
  trainingType    String   // "ON_SITE", "ONLINE", "SEMINAR", "CERTIFICATION"
  maxParticipants Int?
  status          String   @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, CANCELLED
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participants HrTrainingParticipant[]

  @@index([tenantId, status])
}

model HrTrainingParticipant {
  id          String   @id @default(cuid())
  trainingId  String
  employeeId  String
  status      String   @default("REGISTERED") // REGISTERED, ATTENDED, COMPLETED, CANCELLED, NO_SHOW
  score       Decimal? @db.Decimal(5,2)
  certificateUrl String?
  notes       String?
  createdAt   DateTime @default(now())

  training HrTraining @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([trainingId, employeeId])
}

model HrPerformanceReview {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  period      String   // "2025-Q1", "2025-YIL"
  reviewerId  String
  status      String   @default("PENDING") // PENDING, SELF_REVIEW, MANAGER_REVIEW, COMPLETED
  // Puanlar (1-5)
  overallScore    Decimal? @db.Decimal(3,2)
  taskCompletion  Decimal? @db.Decimal(3,2)
  teamwork        Decimal? @db.Decimal(3,2)
  communication   Decimal? @db.Decimal(3,2)
  problemSolving  Decimal? @db.Decimal(3,2)
  leadership      Decimal? @db.Decimal(3,2)
  // Metin değerlendirmeler
  strengths       String?
  developmentAreas String?
  goals           String?
  reviewerNotes   String?
  employeeComment String?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee HrEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer User        @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId])
  @@index([tenantId, period])
  @@index([tenantId, status])
}

// =====================================================================
// HR-8: PUANTAJ / YOKLAMA
// Günlük giriş-çıkış kayıtları, puantaj özeti
// =====================================================================

enum PunchStatus {
  CLOCKED_IN   // Mesai başında
  CLOCKED_OUT  // Mesai sonunda
  ON_BREAK     // Molada
  ABSENT       // Devamsız
}

model HrPunchRecord {
  id            String   @id @default(cuid())
  tenantId      String
  employeeId    String
  punchDate     DateTime @db.Date  // Gün bilgisi (tarih only)
  clockIn       DateTime?          // Giriş saati
  clockOut      DateTime?          // Çıkış saati
  breakStart    DateTime?
  breakEnd      DateTime?
  totalHours    Decimal  @default(0) @db.Decimal(5,2)  // Toplam çalışma saati (net)
  overtimeHours Decimal  @default(0) @db.Decimal(5,2)
  lateMinutes   Int      @default(0)
  earlyMinutes  Int      @default(0)
  status        PunchStatus @default(CLOCKED_OUT)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee HrEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, punchDate])
  @@index([tenantId, punchDate])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

// =====================================================================
// HR-9: AVANS
// Personel avans talepleri ve bordroya mahsup
// =====================================================================

enum AdvanceStatus {
  PENDING    // Beklemede
  APPROVED   // Onaylandı
  REJECTED   // Reddedildi
  PAID       // Ödendi
  DEDUCTED   // Bordroda mahsup edildi
}

model HrAdvanceRequest {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  amount      Decimal  @db.Decimal(15,2)
  reason      String?
  status      AdvanceStatus @default(PENDING)
  requestedBy String   // Kim talep etti (user.id)
  approvedBy  String?
  approvedAt  DateTime?
  paidAt      DateTime?
  paidBy      String?
  deductionMonth String?  // Hangi ay bordrosundan düşülecek
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee HrEmployee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  repayments HrAdvanceRepayment[]

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model HrAdvanceRepayment {
  id            String   @id @default(cuid())
  tenantId      String
  advanceId    String
  periodId      String?  // Hangi bordro döneminde mahsup edildi
  amount        Decimal  @db.Decimal(15,2)
  createdAt     DateTime @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  advance HrAdvanceRequest @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  @@index([tenantId, advanceId])
  @@index([tenantId, periodId])
}
