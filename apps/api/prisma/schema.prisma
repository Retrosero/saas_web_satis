// ============================================
// FAZ 43: Hedef / Performans + Prim
// ============================================

enum TargetType {
  SALES_AMOUNT
  SALES_COUNT
  COLLECTION
  NEW_CUSTOMER
  VISIT_COUNT
  ORDER_COUNT
  BRAND_SALES
  PRODUCT_SALES
}

enum TargetStatus {
  ACTIVE
  COMPLETED
  FAILED
  EXCEEDED
  CANCELLED
}

enum TargetPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum CommissionType {
  PERCENTAGE
  FIXED
  TIERED
  BONUS
}

model PerformanceTarget {
  id              String       @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  type            TargetType
  period          TargetPeriod @default(MONTHLY)
  startDate       DateTime
  endDate         DateTime
  // Atamalar
  assigneeType    String // 'USER' | 'TEAM' | 'BRANCH' | 'ALL'
  assigneeId      String? // userId/teamId/branchId
  assigneeName    String?
  // Hedef değer (tipine göre anlamı değişir)
  targetValue     Decimal
  currency        String       @default("TRY")
  // Tier hedefleri (BONUS için)
  tiers           Json         @default("[]")
  // [{ percent: 80, bonus: 500 }, { percent: 100, bonus: 1000 }]
  // Filtre: marka, ürün, kategori
  filters         Json         @default("{}")
  // { brandIds: [], productIds: [], categoryIds: [] }
  status          TargetStatus @default(ACTIVE)
  // Snapshot'lar
  achievedValue   Decimal      @default(0)
  achievementRate Float        @default(0) // %
  lastSnapshotAt  DateTime?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  isDeleted       Boolean      @default(false)
  deletedAt       DateTime?

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  progressLogs TargetProgressLog[]
  snapshots    PerformanceSnapshot[]

  @@index([tenantId, type])
  @@index([assigneeId, status])
  @@index([startDate, endDate])
}

model TargetProgressLog {
  id            String   @id @default(cuid())
  targetId      String
  achievedValue Decimal
  delta         Decimal
  sourceType    String // 'SALE' | 'COLLECTION' | 'VISIT' | etc.
  sourceId      String?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())

  target PerformanceTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, createdAt])
}

model PerformanceSnapshot {
  id              String   @id @default(cuid())
  tenantId        String
  targetId        String
  userId          String?
  date            DateTime @default(now())
  // günlük snapshot
  achievedValue   Decimal
  targetValue     Decimal
  achievementRate Float
  // Tip bazlı
  metadata        Json     @default("{}")
  // { rank, percentile, periodLabel }

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  target PerformanceTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([targetId, date])
  @@index([userId, date])
}

model CommissionRule {
  id                 String         @id @default(cuid())
  tenantId           String
  name               String
  description        String?
  targetType         TargetType
  // Tetik koşulu
  minAchievementRate Float          @default(100) // %100 üstü prim kazanır
  commissionType     CommissionType
  // PERCENTAGE: { rate: 0.02 } (kazancın %2'si)
  // FIXED: { amount: 500 }
  // TIERED: { tiers: [{ minRate: 80, type: 'PERCENT', value: 0.5 }, { minRate: 100, type: 'PERCENT', value: 1.0 }, { minRate: 150, type: 'FIXED', value: 2000 }] }
  // BONUS: { triggerRate: 120, amount: 1000 }
  config             Json           @default("{}")
  maxAmount          Decimal? // üst limit
  minAmount          Decimal? // alt limit (minimum prim)
  isActive           Boolean        @default(true)
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calculationLogs CommissionCalculationLog[]

  @@index([tenantId, isActive])
  @@index([targetType])
}

model CommissionCalculationLog {
  id               String    @id @default(cuid())
  tenantId         String
  ruleId           String
  userId           String
  userName         String?
  period           String // '2026-Q1', '2026-01', vs.
  targetId         String?
  achievedValue    Decimal
  achievementRate  Float
  // Hesaplanan
  baseAmount       Decimal // temel (satış tutarı)
  calculatedAmount Decimal // hesaplanan prim
  finalAmount      Decimal // uygulanan (min/max sınırları sonrası)
  status           String    @default("PENDING") // PENDING | APPROVED | PAID | REJECTED
  notes            String?
  metadata         Json      @default("{}")
  calculatedAt     DateTime  @default(now())
  approvedAt       DateTime?
  approvedById     String?
  paidAt           DateTime?

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
