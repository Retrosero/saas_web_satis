// FAZ 35: AI Chat & LLM Konfigürasyon
// ============================================

enum LLMProvider {
  OPENROUTER
  OPENAI
  ANTHROPIC
  DEEPSEEK
  OLLAMA
  CUSTOM
}

enum AssistantMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AssistantConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model TenantLLMConfig {
  id               String      @id @default(cuid())
  tenantId         String      @unique
  provider         LLMProvider @default(OPENROUTER)
  apiKey           String // encrypted at rest (basit maskeleme, prod'da KMS)
  baseUrl          String? // null = provider default
  defaultModel     String      @default("deepseek/deepseek-chat")
  fallbackModel    String? // hata durumunda alternatif
  maxTokens        Int         @default(2048)
  temperature      Float       @default(0.3)
  topP             Float       @default(0.9)
  systemPrompt     String?     @db.Text
  // { customSystemPrompt: 'Sen Mavis adında bir Türkçe SaaS asistanısın...' }
  enabledModules   Json        @default("[]")
  // ['sales', 'cari', 'stock', 'reports', 'pricing'] — hangi modüllere erişebilir
  rateLimitPerHour Int         @default(100)
  monthlyBudgetUSD Float? // null = limitsiz
  monthlyUsageUSD  Float       @default(0)
  isActive         Boolean     @default(true)
  // Tool izinleri
  toolPermissions  Json        @default("[]")
  // ['get_customer_balance', 'list_pending_invoices', vs.] — tüm tool'lar için izin listesi
  createdById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations AssistantConversation[]

  @@index([tenantId, isActive])
}

model AssistantConversation {
  id            String                      @id @default(cuid())
  tenantId      String
  userId        String
  title         String // otomatik oluşturulan başlık (ilk mesajdan)
  status        AssistantConversationStatus @default(ACTIVE)
  context       Json                        @default("{}")
  // { lastModule: 'cari', activeFilter: {...} }
  messageCount  Int                         @default(0)
  totalTokens   Int                         @default(0)
  totalCostUSD  Float                       @default(0)
  metadata      Json                        @default("{}")
  // { ip, userAgent, vs. }
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  lastMessageAt DateTime                    @default(now())

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  llmConfig   TenantLLMConfig?    @relation(fields: [llmConfigId], references: [id], onDelete: SetNull)
  llmConfigId String?
  messages    AssistantMessage[]
  toolCalls   AssistantToolCall[]

  @@index([tenantId, userId, status])
  @@index([tenantId, lastMessageAt])
  @@index([userId, status])
}

model AssistantMessage {
  id             String               @id @default(cuid())
  conversationId String
  tenantId       String
  role           AssistantMessageRole
  content        String               @db.Text
  // Tool çağrıları (assistant mesajı içinde)
  toolCalls      Json                 @default("[]")
  // [{ toolId, toolCode, arguments, result, error }]
  tokens         Int? // kullanılan token
  costUSD        Float? // mesaj maliyeti
  model          String? // hangi model kullanıldı
  latencyMs      Int? // yanıt süresi
  feedbackRating Int? // 1-5 (thumbs)
  feedbackNote   String?              @db.Text
  metadata       Json                 @default("{}")
  // { sources: [helpArticleId1, helpArticleId2], retrievedKB: 5 }
  createdAt      DateTime             @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([tenantId, role])
}

model AssistantToolCall {
  id             String   @id @default(cuid())
  conversationId String
  messageId      String?
  tenantId       String
  toolCode       String // 'get_customer_balance'
  toolName       String
  arguments      Json
  result         Json?
  error          String?  @db.Text
  status         String   @default("PENDING") // PENDING | SUCCESS | FAILED
  latencyMs      Int?
  createdAt      DateTime @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([toolCode, status])
  @@index([tenantId, createdAt])
}

model AssistantUsageStats {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  date          DateTime @default(now()) // gün bazında
  model         String
  requestCount  Int      @default(0)
  totalTokens   Int      @default(0)
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalCostUSD  Float    @default(0)
  toolCallCount Int      @default(0)
  errorCount    Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, date, model])
  @@index([tenantId, date])
}

