enum ApprovalTriggerType {
  SALE_OVER_LIMIT
  DISCOUNT_OVER
  RETURN_OVER
  PRICE_CHANGE
  COLLECTION_WRITE_OFF
  EXPENSE_OVER
  EMPLOYEE_ADD
  CASH_TRANSFER_OVER
  INVOICE_CANCEL
  CAMPAIGN_OVER
  STOCK_COUNT_OVER
  WAREHOUSE_TRANSFER
}

enum ApprovalMode {
  SEQUENTIAL
  PARALLEL
  UNANIMOUS
}

enum ApprovalStepType {
  ROLE_BASED
  USER_BASED
  DYNAMIC_FIELD
  SPECIFIC_USERS
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  DELEGATED
}

enum ApprovalActionType {
  APPROVED
  REJECTED
  DELEGATED
  RETURNED
  COMMENTED
}

enum ApprovalPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model ApprovalRule {
  id              String              @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  triggerType     ApprovalTriggerType
  moduleName      String? // hangi modüle bağlı
  conditions      Json                @default("[]")
  // [{ field, operator, value }] - miktar / yüzde / tutar
  mode            ApprovalMode        @default(SEQUENTIAL)
  amountField     String? // ör: "grandTotal" - miktar alanı
  amountThreshold Decimal? // null = koşul bazlı
  expiryHours     Int                 @default(72) // süre aşımı
  isActive        Boolean             @default(true)
  priority        Int                 @default(5)
  triggerCount    Int                 @default(0)
  lastTriggeredAt DateTime?
  settings        Json                @default("{}")
  // { allowDelegation: true, allowReturn: true, notifyOnPending: true }
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  isDeleted       Boolean             @default(false)
  deletedAt       DateTime?

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps    ApprovalStep[]
  requests ApprovalRequest[]

  @@index([tenantId, isActive])
  @@index([tenantId, isDeleted])
  @@index([triggerType])
  @@index([lastTriggeredAt])
}

model ApprovalStep {
  id           String           @id @default(cuid())
  ruleId       String
  stepOrder    Int // 1, 2, 3...
  name         String // "Müdür Onayı", "Genel Müdür Onayı"
  stepType     ApprovalStepType
  // ROLE_BASED: { roleIds: ['role-1'] } - bu role sahip kullanıcılar onaylar
  // USER_BASED: { userId: 'user-1' } - tek kullanıcı
  // DYNAMIC_FIELD: { fieldRef: 'salesperson.managerId' } - dinamik (ör: satış temsilcisinin müdürü)
  // SPECIFIC_USERS: { userIds: ['u1', 'u2'] } - herhangi biri onaylayabilir
  config       Json             @default("{}")
  requireAll   Boolean          @default(false) // SEQUENTIAL dışı - PARALLEL'de tümü mü, herhangi biri mi
  minApprovals Int              @default(1) // PARALLEL için minimum onay sayısı
  timeoutHours Int? // bu adım için özel timeout
  isOptional   Boolean          @default(false) // opsiyonel adım
  description  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  rule    ApprovalRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  actions ApprovalAction[]

  @@unique([ruleId, stepOrder])
  @@index([ruleId, stepOrder])
}

model ApprovalRequest {
  id             String                @id @default(cuid())
  tenantId       String
  ruleId         String
  ruleName       String
  triggerType    ApprovalTriggerType
  // Bağlam — ne onaylanıyor?
  entityType     String // 'Sale', 'Return', 'Discount', etc.
  entityId       String
  entityNumber   String? // 'SLS-2026-001'
  entityLabel    String // 'Satış #123 - 15000 TRY'
  amount         Decimal? // varsa tutar
  amountCurrency String?               @default("TRY")
  requesterId    String // talep eden kullanıcı
  requesterName  String?
  requesterData  Json                  @default("{}") // başvuru anındaki snapshot
  priority       ApprovalPriority      @default(NORMAL)
  status         ApprovalRequestStatus @default(PENDING)
  currentStep    Int                   @default(1) // kaçıncı adımda
  totalSteps     Int
  approvedAt     DateTime?
  rejectedAt     DateTime?
  cancelledAt    DateTime?
  expiredAt      DateTime?
  expiresAt      DateTime? // otomatik expire
  finalComment   String?
  metadata       Json                  @default("{}")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule    ApprovalRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  actions ApprovalAction[]

  @@index([tenantId, createdAt])
  @@index([requesterId])
  @@index([ruleId, status])
  @@index([entityType, entityId])
  @@index([expiresAt])
}

model ApprovalAction {
  id              String             @id @default(cuid())
  requestId       String
  stepId          String
  stepOrder       Int
  stepName        String
  actionType      ApprovalActionType
  actorId         String // işlemi yapan
  actorName       String?
  actorRole       String?
  comment         String?
  attachments     Json               @default("[]")
  delegatedToId   String? // DELEGATED ise kime
  delegatedToName String?
  createdAt       DateTime           @default(now())

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  step    ApprovalStep    @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([actorId])
  @@index([stepId])
}

