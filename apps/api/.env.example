# @saas/api ortam değişkenleri (root .env'den inherit edilir)

NODE_ENV=development
API_PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Database
DATABASE_URL="postgresql://saas:saas@localhost:54432/saas_dev_clean?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS
API_CORS_ORIGINS=http://localhost:5173

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

STORAGE_R2_ACCOUNT_ID=
STORAGE_R2_ACCESS_KEY_ID=
STORAGE_R2_SECRET_ACCESS_KEY=
STORAGE_R2_BUCKET=saas-files
STORAGE_R2_PUBLIC_URL=

# Super admin seed
SUPER_ADMIN_EMAIL=admin@sistem.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME="Sistem Yöneticisi"
